<% titre = 'Nouvelle sortie' %>
<%- include('partials/head') %>

<h1 class="titre-app">Retrouvailles</h1>
<p class="sous-titre">Propose une sortie, tout le monde vote, le meilleur jour ressort tout seul.</p>

<form class="carte" method="post" action="/evenements" id="formulaire-creation">
  <% if (erreur) { %>
    <p class="message-erreur"><%= erreur %></p>
  <% } %>

  <div class="champ">
    <span>Comment veux-tu proposer la sortie ?</span>
    <div class="bascule-mode">
      <button type="button" class="bouton-mode bouton-mode-actif" data-mode="dates_precises">Je propose des dates</button>
      <button type="button" class="bouton-mode" data-mode="calendrier_libre">Calendrier ouvert</button>
    </div>
    <input type="hidden" name="mode" id="champ-mode" value="dates_precises" />
  </div>

  <label class="champ">
    <span>Titre de la sortie</span>
    <input type="text" name="titre" placeholder="Dispo pour un verre ?" required maxlength="120" autofocus />
  </label>

  <label class="champ">
    <span>Ton prénom</span>
    <input type="text" name="createurPrenom" placeholder="Ton prénom" required maxlength="40" />
  </label>

  <div class="champ">
    <span id="etiquette-calendrier-creation">Touche les jours qui t'intéressent. Ils passent en jaune.</span>
    <div class="calendrier" id="calendrier-creation">
      <% joursCreation.forEach(function(j) { %>
        <% if (j.premierDuMois) { %><div class="entete-mois"><%= j.moisLabel %></div><% } %>
        <button type="button" class="case-jour" data-jour="<%= j.jour %>">
          <span class="case-jour-semaine"><%= j.jourSemaine %></span>
          <span class="case-jour-nombre"><%= j.jourNombre %></span>
        </button>
      <% }) %>
    </div>
  </div>

  <div id="conteneur-champs-caches"></div>

  <button type="submit" class="bouton bouton-principal bouton-pleine-largeur">Créer la sortie</button>
</form>

<% if (exemples && exemples.length > 0) { %>
  <% exemples.forEach(function(ex) { %>
    <p class="lien-discret">
      <a href="/e/<%= ex.id %>">Voir un exemple<%= ex.mode === 'calendrier_libre' ? ' (calendrier ouvert)' : ' (dates précises)' %></a>
    </p>
  <% }) %>
<% } %>

<script src="/js/accueil.js"></script>
<%- include('partials/foot') %>
