<% titre = 'Nouvelle sortie' %>
<%- include('partials/head') %>

<h1 class="titre-app">Retrouvailles</h1>
<p class="sous-titre">Propose une sortie, tout le monde vote ses jours dispo, le meilleur jour ressort tout seul.</p>

<form class="carte" method="post" action="/evenements">
  <% if (erreur) { %>
    <p class="message-erreur"><%= erreur %></p>
  <% } %>

  <label class="champ">
    <span>Titre de la sortie</span>
    <input type="text" name="titre" placeholder="Dispo pour un verre ?" required maxlength="120" autofocus />
  </label>

  <label class="champ">
    <span>Du</span>
    <input type="date" name="dateDebut" value="<%= debutParDefaut %>" required />
  </label>

  <label class="champ">
    <span>Au</span>
    <input type="date" name="dateFin" value="<%= finParDefaut %>" required />
  </label>

  <button type="submit" class="bouton bouton-principal">Créer la sortie</button>
</form>

<% if (idExemple) { %>
  <p class="lien-discret"><a href="/e/<%= idExemple %>">Voir un exemple avec des votes déjà remplis</a></p>
<% } %>

<%- include('partials/foot') %>
