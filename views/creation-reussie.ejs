<% titre = 'Sortie créée' %>
<%- include('partials/head') %>

<h1 class="titre-app">C'est créé !</h1>
<p class="sous-titre">Un seul lien à partager avec tout le monde. Ton navigateur te reconnaîtra automatiquement comme organisateur quand tu l'ouvriras.</p>

<div class="carte">
  <div class="bloc-lien">
    <span class="etiquette-lien">Lien à partager avec tes amis</span>
    <div class="ligne-copie">
      <input type="text" readonly value="<%= lienPartage %>" onclick="this.select()" id="champ-lien-partage" />
      <button type="button" class="bouton-copier" data-cible="champ-lien-partage">Copier</button>
    </div>
  </div>
</div>

<a class="bouton bouton-principal bouton-pleine-largeur" href="<%= lienPartage %>">Aller à la page de la sortie</a>

<script src="/js/copier.js"></script>
<%- include('partials/foot') %>
