<% titre = 'Sortie créée' %>
<%- include('partials/head') %>

<h1 class="titre-app">C'est créé !</h1>
<p class="sous-titre">Voici tes deux liens. Garde bien le lien organisateur, il ne sera plus réaffiché.</p>

<div class="carte">
  <div class="bloc-lien">
    <span class="etiquette-lien">Lien à partager avec tes amis</span>
    <div class="ligne-copie">
      <input type="text" readonly value="<%= lienPartage %>" onclick="this.select()" id="champ-lien-partage" />
      <button type="button" class="bouton-copier" data-cible="champ-lien-partage">Copier</button>
    </div>
  </div>

  <div class="bloc-lien bloc-lien-secret">
    <span class="etiquette-lien">Ton lien organisateur (secret, garde-le pour toi)</span>
    <div class="ligne-copie">
      <input type="text" readonly value="<%= lienOrganisateur %>" onclick="this.select()" id="champ-lien-organisateur" />
      <button type="button" class="bouton-copier" data-cible="champ-lien-organisateur">Copier</button>
    </div>
  </div>
</div>

<a class="bouton bouton-principal bouton-pleine-largeur" href="<%= lienOrganisateur %>">Aller à la page de la sortie</a>

<script src="/js/copier.js"></script>
<%- include('partials/foot') %>
