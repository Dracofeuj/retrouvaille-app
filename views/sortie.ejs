<% titre = evenement.titre %>
<%- include('partials/head') %>

<div class="entete-sortie">
  <div>
    <h1 class="titre-app titre-sortie"><%= evenement.titre %></h1>
    <p class="organise-par">Organisé par <%= evenement.createurPrenom %><% if (plageHeures) { %> · <%= plageHeures %><% } %></p>
  </div>
  <% if (estOrganisateur) { %>
    <p class="badge-role">Organisateur</p>
  <% } %>
</div>

<% if (evenement.statut === 'confirme') { %>
  <div class="bandeau-confirme">
    ✅ <%= texteValidation %>
  </div>
<% } %>

<section class="carte" id="section-mes-dispos">
  <h2 class="titre-section">Mes disponibilités</h2>

  <label class="champ">
    <span>Ton prénom</span>
    <input type="text" id="champ-prenom" placeholder="Ton prénom" maxlength="40" />
  </label>

  <p class="aide">Touche les jours où tu es dispo. Ils passent en jaune.</p>

  <div class="calendrier" id="calendrier-perso">
    <% joursAffiches.forEach(function(j) { %>
      <% if (j.premierDuMois) { %><div class="entete-mois"><%= j.moisLabel %></div><% } %>
      <button type="button" class="case-jour" data-jour="<%= j.jour %>">
        <span class="case-jour-semaine"><%= j.jourSemaine %></span>
        <span class="case-jour-nombre"><%= j.jourNombre %></span>
      </button>
    <% }) %>
  </div>

  <% if (lieuxListe.length > 0) { %>
    <p class="aide">Quels lieux te vont ?</p>
    <div class="pilules-lieux" id="pilules-lieux-perso">
      <% lieuxListe.forEach(function(l) { %>
        <button type="button" class="pilule-lieu" data-lieu="<%= l.id %>"><%= l.nom %></button>
      <% }) %>
    </div>
  <% } %>

  <button type="button" class="bouton bouton-principal bouton-pleine-largeur" id="bouton-enregistrer">
    Enregistrer mes disponibilités
  </button>
  <p class="message-etat" id="message-etat"></p>

  <% if (evenement.mode === 'dates_precises') { %>
    <form method="post" action="/e/<%= evenement.id %>/contre-proposition" id="formulaire-contre-proposition" class="bloc-contre-proposition">
      <p class="aide">Aucune date qui te branche ? Propose la tienne :</p>
      <div class="ligne-contre-proposition">
        <input type="date" name="jour" required />
        <input type="hidden" name="prenom" id="champ-prenom-contre-proposition" />
        <button type="submit" class="bouton bouton-secondaire">Proposer</button>
      </div>
    </form>
  <% } %>

  <form method="post" action="/e/<%= evenement.id %>/contre-proposition-lieu" id="formulaire-contre-proposition-lieu" class="bloc-contre-proposition">
    <p class="aide">Un autre lieu à proposer ?</p>
    <div class="ligne-contre-proposition">
      <input type="text" name="nom" placeholder="Nom du lieu" maxlength="120" required />
      <input type="hidden" name="prenom" id="champ-prenom-contre-proposition-lieu" />
      <button type="submit" class="bouton bouton-secondaire">Proposer</button>
    </div>
  </form>
</section>

<section class="carte">
  <h2 class="titre-section">Vue du groupe</h2>
  <p class="aide">
    <% if (totalParticipants === 0) { %>
      Personne n'a encore voté.
    <% } else { %>
      <%= totalParticipants %> participant<%= totalParticipants > 1 ? 's' : '' %> ont voté.
    <% } %>
  </p>

  <% if (joursListe.length === 0) { %>
    <p class="aide">Aucun vote de date pour l'instant.</p>
  <% } else { %>
    <div class="liste-votes">
      <% joursListe.forEach(function(j) { %>
        <%- include('partials/ligne-vote', { libelle: j.libelleCourt, pourcentage: j.pourcentage, compteTexte: j.compteTexte, estMeilleur: j.estMeilleur, estValide: j.estValide }) %>
      <% }) %>
    </div>
  <% } %>

  <% if (lieuxListe.length > 0) { %>
    <h3 class="titre-sous-section">Lieux</h3>
    <div class="liste-votes">
      <% lieuxListe.forEach(function(l) { %>
        <%- include('partials/ligne-vote', { libelle: l.nom, pourcentage: l.pourcentage, compteTexte: l.compteTexte, estMeilleur: l.estMeilleur, estValide: l.estValide }) %>
      <% }) %>
    </div>
  <% } %>

  <% if (participants.length > 0) { %>
    <p class="liste-participants-etiquette">A voté :</p>
    <div class="liste-participants">
      <% participants.forEach(function(p) { %>
        <button type="button" class="pilule-participant" data-participant-id="<%= p.id %>"><%= p.prenom %></button>
      <% }) %>
    </div>
  <% } %>
</section>

<section class="carte" id="galerie">
  <h2 class="titre-section">Photos souvenir</h2>

  <form method="post" action="/e/<%= evenement.id %>/photos" enctype="multipart/form-data" id="formulaire-photos" class="bloc-upload-photos">
    <input type="hidden" name="prenom" id="champ-prenom-photos" />
    <label class="bouton bouton-secondaire bouton-pleine-largeur bouton-choisir-photos" for="champ-fichiers-photos">
      + Ajouter des photos
    </label>
    <input type="file" name="photos" id="champ-fichiers-photos" accept="image/png,image/jpeg,image/heic" multiple hidden />
    <p class="message-etat" id="message-etat-photos"></p>
  </form>

  <% if (photos.length === 0) { %>
    <p class="aide">Aucune photo pour l'instant.</p>
  <% } else { %>
    <div class="galerie-photos">
      <% photos.forEach(function(photo) { %>
        <button type="button" class="vignette-photo" data-photo-url="<%= photo.url %>" aria-label="Photo de <%= photo.ajouteParPrenom %>">
          <img src="<%= photo.url %>" alt="Photo ajoutée par <%= photo.ajouteParPrenom %>" loading="lazy" />
        </button>
      <% }) %>
    </div>
  <% } %>
</section>

<% if (estOrganisateur && datesEnAttente && datesEnAttente.length > 0) { %>
<section class="carte">
  <h2 class="titre-section">Contre-propositions de dates en attente</h2>
  <% datesEnAttente.forEach(function(dp) { %>
    <div class="ligne-attente">
      <span class="ligne-attente-texte"><%= formaterJourLong(dp.jour) %><br><span class="ligne-attente-auteur">proposé par <%= dp.proposeParPrenom %></span></span>
      <div class="boutons-attente">
        <form method="post" action="/e/<%= evenement.id %>/dates-proposees/<%= dp.id %>/accepter">
          <button type="submit" class="bouton-pastille bouton-pastille-accepter">Accepter</button>
        </form>
        <form method="post" action="/e/<%= evenement.id %>/dates-proposees/<%= dp.id %>/refuser">
          <button type="submit" class="bouton-pastille bouton-pastille-refuser">Refuser</button>
        </form>
      </div>
    </div>
  <% }) %>
</section>
<% } %>

<% if (estOrganisateur && lieuxEnAttente && lieuxEnAttente.length > 0) { %>
<section class="carte">
  <h2 class="titre-section">Contre-propositions de lieu en attente</h2>
  <% lieuxEnAttente.forEach(function(lp) { %>
    <div class="ligne-attente">
      <span class="ligne-attente-texte"><%= lp.nom %><br><span class="ligne-attente-auteur">proposé par <%= lp.proposeParPrenom %></span></span>
      <div class="boutons-attente">
        <form method="post" action="/e/<%= evenement.id %>/lieux-proposes/<%= lp.id %>/accepter">
          <button type="submit" class="bouton-pastille bouton-pastille-accepter">Accepter</button>
        </form>
        <form method="post" action="/e/<%= evenement.id %>/lieux-proposes/<%= lp.id %>/refuser">
          <button type="submit" class="bouton-pastille bouton-pastille-refuser">Refuser</button>
        </form>
      </div>
    </div>
  <% }) %>
</section>
<% } %>

<% if (estOrganisateur && evenement.statut !== 'confirme') { %>
<section class="carte">
  <h2 class="titre-section">Valider la sortie</h2>
  <% if (totalParticipants === 0) { %>
    <p class="aide">Attends au moins un vote avant de valider.</p>
  <% } else { %>
    <form method="post" action="/e/<%= evenement.id %>/valider-sortie">
      <label class="champ">
        <span>Jour à confirmer</span>
        <select name="jour" required>
          <% joursAffiches.forEach(function(j) { %>
            <option value="<%= j.jour %>" <%= j.estMeilleur ? 'selected' : '' %>>
              <%= j.libelleCourt %> — <%= j.nombreDispos %> dispo<%= j.nombreDispos > 1 ? 's' : '' %>
            </option>
          <% }) %>
        </select>
      </label>
      <% if (lieuxListe.length > 0) { %>
        <label class="champ">
          <span>Lieu à confirmer</span>
          <select name="lieuId" required>
            <% lieuxListe.forEach(function(l) { %>
              <option value="<%= l.id %>" <%= l.estMeilleur ? 'selected' : '' %>>
                <%= l.nom %> — <%= l.compteTexte %>
              </option>
            <% }) %>
          </select>
        </label>
      <% } %>
      <button type="submit" class="bouton bouton-valider bouton-pleine-largeur">Valider la sortie</button>
    </form>
  <% } %>
</section>
<% } %>

<p class="lien-discret">
  <button type="button" class="lien-comme-bouton" id="bouton-copier-partage" data-lien="<%= lienPartage %>">
    Copier le lien
  </button>
  <span class="lien-sous-texte">pour inviter du monde</span>
</p>

<!-- Fiche participant (ouverte au clic sur un prenom) -->
<div class="overlay-modale" id="modale-participant" hidden>
  <div class="carte modale-contenu">
    <button type="button" class="bouton-fermer-modale" id="bouton-fermer-modale-participant" aria-label="Fermer">&times;</button>
    <h2 class="titre-section" id="modale-participant-prenom"></h2>

    <div id="modale-participant-connecte-requis" hidden>
      <p class="aide">Connecte-toi pour ajouter cette personne à un de tes cercles.</p>
      <a class="bouton bouton-principal bouton-pleine-largeur" id="lien-connexion-depuis-modale">Se connecter</a>
    </div>

    <div id="modale-participant-ajout-cercle" hidden>
      <label class="champ">
        <span>Ajouter à un cercle</span>
        <select id="select-cercle-modale">
          <option value="">Choisis un cercle...</option>
          <option value="__nouveau__">+ Créer un nouveau cercle</option>
        </select>
      </label>
      <input type="text" id="champ-nouveau-cercle-modale" class="champ-texte-modale" placeholder="Nom du nouveau cercle" hidden />
      <button type="button" class="bouton bouton-principal bouton-pleine-largeur" id="bouton-confirmer-ajout-cercle">Ajouter</button>
      <p class="message-etat" id="message-etat-modale"></p>
    </div>
  </div>
</div>

<!-- Plein ecran pour une photo -->
<div class="overlay-modale overlay-photo" id="modale-photo" hidden>
  <button type="button" class="bouton-fermer-modale bouton-fermer-photo" id="bouton-fermer-modale-photo" aria-label="Fermer">&times;</button>
  <img src="" alt="" id="image-modale-photo" />
</div>

<script>
  window.DONNEES_SORTIE = {
    evenementId: <%- JSON.stringify(evenement.id) %>,
    estOrganisateur: <%- JSON.stringify(estOrganisateur) %>,
    // Ne sert qu'a pre-remplir le prenom : seul le navigateur reconnu comme
    // organisateur (cookie verifie cote serveur) recoit cette info.
    prenomOrganisateur: <%- JSON.stringify(estOrganisateur ? evenement.createurPrenom : null) %>,
    estConfirme: <%- JSON.stringify(evenement.statut === 'confirme') %>,
    texteValidation: <%- JSON.stringify(texteValidation) %>,
    utilisateurConnecte: <%- JSON.stringify(utilisateurConnecte) %>,
  };
</script>
<script src="/js/copier.js"></script>
<script src="/js/sortie.js"></script>
<script src="/js/animation-validation.js"></script>
<script src="/js/participant-modale.js"></script>
<script src="/js/photos.js"></script>
<%- include('partials/foot') %>
