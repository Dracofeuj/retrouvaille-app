<% titre = 'Nouvelle sortie' %>
<%- include('partials/head') %>

<h1 class="titre-app">Nouvelle sortie</h1>
<p class="sous-titre">On propose, on vote, et cette fois on se voit vraiment.</p>

<form class="carte" method="post" action="/evenements" id="formulaire-creation">
  <% if (erreur) { %>
    <p class="message-erreur"><%= erreur %></p>
  <% } %>

  <div class="champ">
    <span>Comment on fait ?</span>
    <div class="bascule-mode">
      <button type="button" class="bouton-mode bouton-mode-actif" data-mode="dates_precises">Des dates précises</button>
      <button type="button" class="bouton-mode" data-mode="calendrier_libre">Un calendrier ouvert</button>
    </div>
    <input type="hidden" name="mode" id="champ-mode" value="dates_precises" />
  </div>

  <label class="champ">
    <span>Titre de la sortie</span>
    <input type="text" name="titre" placeholder="Dispo pour un verre ?" required maxlength="120" autofocus />
  </label>

  <label class="champ">
    <span>Ton prénom</span>
    <input type="text" name="createurPrenom" placeholder="Ton prénom" required maxlength="40" />
  </label>

  <div class="champ">
    <span id="etiquette-calendrier-creation">Touche les jours qui te tentent, ils passent en jaune.</span>
    <div class="calendrier-nav">
      <button type="button" id="bouton-mois-precedent" aria-label="Mois précédent">‹</button>
      <span id="libelle-mois-affiche"></span>
      <button type="button" id="bouton-mois-suivant" aria-label="Mois suivant">›</button>
    </div>
    <div class="grille-jours-semaine">
      <span>lun</span><span>mar</span><span>mer</span><span>jeu</span><span>ven</span><span>sam</span><span>dim</span>
    </div>
    <div class="grille-mois" id="calendrier-creation"></div>
  </div>

  <input type="hidden" id="champ-aujourdhui" value="<%= debutParDefaut %>" />
  <div id="conteneur-champs-caches"></div>

  <div class="champ">
    <span>Heure (facultatif)</span>
    <div class="ligne-heures">
      <select name="heureDebut">
        <option value="">Début : à définir</option>
        <% optionsHeure.forEach(function(o) { %>
          <option value="<%= o.valeur %>">Début : <%= o.libelle %></option>
        <% }) %>
      </select>
      <select name="heureFin">
        <option value="">Fin : à définir</option>
        <% optionsHeure.forEach(function(o) { %>
          <option value="<%= o.valeur %>">Fin : <%= o.libelle %></option>
        <% }) %>
      </select>
    </div>
  </div>

  <div class="champ">
    <span>Lieu proposé (facultatif)</span>
    <div id="liste-lieux">
      <div class="ligne-lieu">
        <input type="text" name="lieux" placeholder="Ex : Chez Papa" maxlength="120" />
      </div>
    </div>
    <button type="button" class="lien-comme-bouton" id="bouton-ajouter-lieu">+ Ajouter un lieu</button>
  </div>

  <button type="submit" class="bouton bouton-principal bouton-pleine-largeur">On lance la sortie</button>
</form>

<% if (exemples && exemples.length > 0) { %>
  <% exemples.forEach(function(ex) { %>
    <p class="lien-discret">
      <a href="/e/<%= ex.id %>">Voir un exemple<%= ex.mode === 'calendrier_libre' ? ' (calendrier ouvert)' : ' (dates précises)' %></a>
    </p>
  <% }) %>
<% } %>

<script src="/js/accueil.js"></script>
<%- include('partials/foot') %>
