// Schema de la base de donnees (SQLite pour demarrer, PostgreSQL plus tard
// en changeant juste "provider" ci-dessous + la variable DATABASE_URL).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Une sortie proposee par un organisateur.
model Evenement {
  id             String   @id @default(cuid())
  titre          String
  mode           String   @default("dates_precises") // "dates_precises" ou "calendrier_libre"
  dateDebut      String // format AAAA-MM-JJ (simple date, sans heure/fuseau)
  dateFin        String // format AAAA-MM-JJ
  heureDebut     String? // format HH:MM, facultatif ("a definir" si vide)
  heureFin       String? // format HH:MM, facultatif
  statut         String   @default("en_cours") // "en_cours" ou "confirme"
  jourValide     String? // format AAAA-MM-JJ, rempli quand confirme
  lieuValideId   String? // id du LieuPropose retenu, rempli quand confirme
  createurPrenom String
  // Jeton compare au cookie pose sur le navigateur du createur pour le
  // reconnaitre comme organisateur (voir lib/organisateur.js) quand il n'est
  // pas connecte. S'il est connecte, createurUserId prend le relai (voir
  // lib/auth.js) : les deux mecanismes cohabitent sans se gener.
  jetonCreateur   String   @unique @default(cuid())
  createurUserId  String?
  createdAt       DateTime @default(now())

  createurUser   User?          @relation(fields: [createurUserId], references: [id])
  participants   Participant[]
  datesProposees DateProposee[]
  lieuxProposes  LieuPropose[]
  photos         Photo[]
}

// Une photo souvenir ajoutee par un participant (avec ou sans compte) sur
// la page d'une sortie.
model Photo {
  id              String   @id @default(cuid())
  evenementId     String
  url             String
  ajouteParPrenom String
  createdAt       DateTime @default(now())

  evenement Evenement @relation(fields: [evenementId], references: [id], onDelete: Cascade)
}

// Une date precise, utilisee seulement en mode "dates_precises". Les dates
// proposees par le createur a la creation sont deja "validee" ; celles
// proposees par un invite en contre-proposition arrivent "en_attente"
// jusqu'a ce que l'organisateur les accepte.
model DateProposee {
  id               String   @id @default(cuid())
  evenementId      String
  jour             String // format AAAA-MM-JJ
  statut           String   @default("validee") // "validee" ou "en_attente"
  proposeParPrenom String?
  createdAt        DateTime @default(now())

  evenement Evenement @relation(fields: [evenementId], references: [id], onDelete: Cascade)

  @@unique([evenementId, jour])
}

// Un lieu propose pour la sortie. Meme logique que DateProposee : celui/ceux
// donnes par le createur a la creation sont deja "valide" ; une
// contre-proposition d'un invite arrive "en_attente" jusqu'a acceptation
// par l'organisateur.
model LieuPropose {
  id               String   @id @default(cuid())
  evenementId      String
  nom              String
  statut           String   @default("valide") // "valide" ou "en_attente"
  proposeParPrenom String?
  createdAt        DateTime @default(now())

  evenement Evenement @relation(fields: [evenementId], references: [id], onDelete: Cascade)
  votes     VoteLieu[]

  @@unique([evenementId, nom])
}

// Une personne qui a vote sur une sortie : juste un prenom, pas besoin de
// compte. Si elle etait connectee au moment du vote, userId la relie a son
// compte (pour apparaitre dans son tableau de bord) mais rien d'autre ne change.
model Participant {
  id          String   @id @default(cuid())
  evenementId String
  prenom      String
  userId      String?
  createdAt   DateTime @default(now())

  evenement Evenement  @relation(fields: [evenementId], references: [id], onDelete: Cascade)
  user      User?      @relation(fields: [userId], references: [id])
  dispos    Dispo[]
  votesLieu VoteLieu[]

  @@unique([evenementId, prenom]) // un seul "profil" par prenom sur une sortie
}

// Un jour ou un participant a indique etre disponible.
model Dispo {
  id            String @id @default(cuid())
  participantId String
  jour          String // format AAAA-MM-JJ

  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([participantId, jour])
}

// Un lieu qu'un participant approuve.
model VoteLieu {
  id            String @id @default(cuid())
  participantId String
  lieuProposeId String

  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  lieuPropose LieuPropose @relation(fields: [lieuProposeId], references: [id], onDelete: Cascade)

  @@unique([participantId, lieuProposeId])
}

// ---------- Comptes (connexion par code email, sans mot de passe) ----------

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())

  evenementsCrees Evenement[]
  participations  Participant[]
  sessions        Session[]
  cerclesCrees    Cercle[]
  membreDe        MembreCercle[]
}

// Code a usage unique envoye par email pour se connecter (en mode test pour
// l'instant, le code est affiche directement a l'ecran au lieu d'etre
// envoye par email - voir lib/auth.js).
model CodeConnexion {
  id        String   @id @default(cuid())
  email     String
  code      String
  expireA   DateTime
  utilise   Boolean  @default(false)
  createdAt DateTime @default(now())
}

// Une session ouverte : son id est stocke dans un cookie "session" sur le
// navigateur de l'utilisateur.
model Session {
  id        String   @id @default(cuid())
  userId    String
  expireA   DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------- Cercles (groupes persistants) ----------

// Un cercle d'amis/famille. Necessite un compte (contrairement aux
// evenements, qui restent accessibles sans compte).
model Cercle {
  id     String @id @default(cuid())
  nom    String
  // Lien d'invitation pour rejoindre le cercle (rejoindre = arriver avec un
  // compte ; voir route GET /rejoindre/:jetonInvitation).
  jetonInvitation String @unique @default(cuid())
  createurId      String
  createdAt       DateTime @default(now())

  createur User           @relation(fields: [createurId], references: [id])
  membres  MembreCercle[]
}

// Un membre d'un cercle. `nomAffiche` est un instantane du prenom utilise au
// moment de l'ajout (ex: le prenom qu'il avait sur l'evenement source) : ca
// evite de dependre d'un futur systeme de profil pour juste afficher un nom
// dans la liste des membres.
model MembreCercle {
  id          String   @id @default(cuid())
  cercleId    String
  userId      String
  nomAffiche  String?
  createdAt   DateTime @default(now())

  cercle Cercle @relation(fields: [cercleId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([cercleId, userId])
}
